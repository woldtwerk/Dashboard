{
  "name": "allmight-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.calendar.config.ts && drizzle-kit generate --config drizzle.drive.config.ts && drizzle-kit generate --config drizzle.logs.config.ts && drizzle-kit generate --config drizzle.automation.config.ts && drizzle-kit generate --config drizzle.contacts.config.ts",
    "pwa:icons": "pnpm --filter @allmight/core exec pwa-assets-generator --preset minimal-2023 public/logo.svg"
  },
  "dependencies": {
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "nuxt": "catalog:"
  },
  "devDependencies": {
    "@nuxt/eslint": "catalog:",
    "@pinia/colada": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@12.23.0"
}
