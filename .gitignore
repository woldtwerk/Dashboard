# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
/logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Generated by .ddev/scripts/ensure-secrets.sh: the lumo-tamer proxy config (holds
# the proxy API key) and its vault key, which must never be regenerated
.ddev/tamer/config.yaml
.ddev/tamer/secrets/

# Test builds (NUXT_BUILD_DIR / NUXT_OUTPUT_DIR)
.nuxt-*
.output-*

# Git worktrees of parallel coding agents
.worktrees/

# drizzle-kit migrations are source; a global *.sql ignore must not hide them
!layers/*/server/db/**/*.sql
