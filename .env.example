# Encrypts stored service settings (credentials). At least 32 characters: openssl rand -base64 32
# Changing it makes existing services unreadable; they have to be set up again.
NUXT_APP_SECRET=

# Minimum level persisted and streamed: debug, info, warn or error (default: info)
# NUXT_LOGS_LEVEL=info
# Days of log lines to keep, and the hard entry limit (defaults: 7 and 50000)
# NUXT_LOGS_RETENTION_DAYS=7
# NUXT_LOGS_MAX_ENTRIES=50000
